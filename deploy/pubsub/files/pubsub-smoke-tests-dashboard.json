{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "title": "pubsub — K6 Smoke Tests",
  "uid": "pubsub-k6-smoke-tests",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["pubsub", "smoke-tests", "k6"],
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "query_result(count by (version) (count_over_time(k6_smoke_overall_result_rate{service=\"pubsub\", cluster=\"{{ include "pubsub.smokeCluster" . }}\"}[30d])))",
        "hide": 0,
        "includeAll": false,
        "label": "Chart Version",
        "multi": false,
        "name": "version",
        "options": [],
        "query": {
          "qryType": 3,
          "query": "query_result(count by (version) (count_over_time(k6_smoke_overall_result_rate{service=\"pubsub\", cluster=\"{{ include "pubsub.smokeCluster" . }}\"}[30d])))"
        },
        "refresh": 2,
        "regex": "/.*version=\"([^\\\"]+)\".*/",
        "skipUrlSync": false,
        "sort": 2,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "| **Service** | **Cluster** | **Version** | **Scenarios** | **Threshold** |\n|:--|:--|:--|:--|:--|\n| `pubsub` | `{{ include "pubsub.smokeCluster" . }}` | `$version` | 2 (sc01 Deployment readiness via Kubernetes API; sc02 pod-internal /health and /ready on every ready pod; read-only, gRPC not called) | ≥ 95% = PASS |",
        "mode": "markdown"
      },
      "title": "Test Info",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#F2495C", "value": null }, { "color": "#73BF69", "value": 0.95 } ] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg(last_over_time(k6_smoke_overall_result_rate{service=\"pubsub\", cluster=\"{{ include "pubsub.smokeCluster" . }}\", version=\"$version\"}[${__range_s}s]))",
          "refId": "A"
        }
      ],
      "title": "Overall Pass Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "id": 4,
      "fieldConfig": { "defaults": { "mappings": [], "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(last_over_time(k6_smoke_group_result_rate{service=\"pubsub\", cluster=\"{{ include "pubsub.smokeCluster" . }}\", version=\"$version\"}[${__range_s}s])) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Test Groups Reporting",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#F2495C", "value": null }, { "color": "#73BF69", "value": 0.95 } ] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "last_over_time(k6_smoke_group_result_rate{service=\"pubsub\", cluster=\"{{ include "pubsub.smokeCluster" . }}\", version=\"$version\"}[${__range_s}s])",
          "legendFormat": "{{ "{{" }} test_group {{ "}}" }}",
          "refId": "A"
        }
      ],
      "title": "Pass Rate by Test Group",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 19 },
      "id": 7,
      "fieldConfig": { "defaults": { "mappings": [], "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by (version) (last_over_time(k6_smoke_overall_result_rate{service=\"pubsub\", cluster=\"{{ include "pubsub.smokeCluster" . }}\"}[${__range_s}s]))",
          "legendFormat": "{{ "{{" }} version {{ "}}" }}",
          "refId": "A"
        }
      ],
      "title": "Version History (overall pass rate)",
      "type": "timeseries"
    }
  ]
}
